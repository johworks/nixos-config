    {
      "id": 7,
      "title": "Internet bandwidth",
      "type": "timeseries",
      "description": "WAN (vlan10) only, including traffic generated by the NUC. LAN and trunk counters are not added to these totals.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "8 * rate(node_network_receive_bytes_total{job=\"node\",device=\"vlan10\"}[$__rate_interval])",
          "legendFormat": "Download",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "8 * rate(node_network_transmit_bytes_total{job=\"node\",device=\"vlan10\"}[$__rate_interval])",
          "legendFormat": "Upload",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "title": "Internet latency",
      "type": "timeseries",
      "description": "Round-trip latency from the NUC. Compare with bandwidth to investigate latency under load; failed probes have gaps.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_icmp_duration_seconds{job=\"internet-icmp\",phase=\"rtt\"} AND on(job,instance) (probe_success{job=\"internet-icmp\"} == 1)",
          "legendFormat": "{{destination}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "title": "Download \u00b7 last 24 hours",
