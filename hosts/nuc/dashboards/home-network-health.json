        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - ax1450_memory_available_bytes / ax1450_memory_total_bytes)) and on(job,instance) (ax1450_metrics_collection_success == 1) and on(job,instance) (time() - ax1450_metrics_sample_timestamp_seconds < 90)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 22,
      "title": "AP uptime",
      "type": "stat",
      "description": "Time since the AX1450 booted.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
