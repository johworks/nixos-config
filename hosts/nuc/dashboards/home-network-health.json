        {
          "refId": "A",
          "expr": "(ax1450_uptime_seconds) and on(job,instance) (ax1450_metrics_collection_success == 1) and on(job,instance) (time() - ax1450_metrics_sample_timestamp_seconds < 90)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
