prefix_rule(
    pattern = ["nix", "eval"],
    decision = "allow",
    justification = "Read-only Nix evaluation is routine validation for this NixOS flake.",
)

prefix_rule(
    pattern = ["nix", "flake", ["show", "metadata"]],
    decision = "allow",
    justification = "Read-only flake inspection is routine validation.",
)

prefix_rule(
    pattern = ["nix", "flake", "metadata"],
    decision = "allow",
    justification = "Read-only flake metadata inspection is routine validation.",
)

prefix_rule(
    pattern = ["nix", "flake", "check"],
    decision = "prompt",
    justification = "Flake checks can build or run checks, so keep an explicit approval gate.",
)

prefix_rule(
    pattern = ["nix", "derivation", "show"],
    decision = "allow",
    justification = "Derivation show is read-only inspection used to debug Nix evaluation outputs.",
)

prefix_rule(
    pattern = ["nix", "--store", "daemon", "eval"],
    decision = "allow",
    justification = "Daemon-backed Nix evaluation is routine read-only validation inside the Codex sandbox.",
)

prefix_rule(
    pattern = ["nix", "--store", "daemon", "flake", "metadata"],
    decision = "allow",
    justification = "Daemon-backed flake metadata inspection is routine read-only validation inside the Codex sandbox.",
)

prefix_rule(
    pattern = ["nix", "--store", "daemon", "derivation", "show"],
    decision = "allow",
    justification = "Daemon-backed derivation show is read-only inspection used to debug Nix evaluation outputs.",
)

prefix_rule(
    pattern = ["nix", "build"],
    decision = "prompt",
    justification = "Nix builds can realize store paths, so keep an explicit approval gate.",
)

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Git status is read-only repository inspection.",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Git diff is read-only repository inspection.",
)

prefix_rule(
    pattern = ["git", "ls-files"],
    decision = "allow",
    justification = "Git ls-files is read-only repository inspection.",
)

prefix_rule(
    pattern = ["git", "add", "-N"],
    decision = "allow",
    justification = "Intent-to-add makes new files visible to git-based Nix flakes without staging contents.",
)

prefix_rule(
    pattern = ["git", "add", "--intent-to-add"],
    decision = "allow",
    justification = "Intent-to-add makes new files visible to git-based Nix flakes without staging contents.",
)
